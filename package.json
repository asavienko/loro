{
  "name": "loro",
  "private": true,
  "version": "0.0.0",
  "description": "Loro — learn Spanish by the phrase. iOS + Android.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "check": "pnpm check:routes && pnpm check:reuse && pnpm check:plan-index && pnpm test:android-config && pnpm test:deploy && pnpm test:ci-local && pnpm test:native:evidence && pnpm test:dsp:spike && pnpm test:core-rs-build && pnpm contracts:check && pnpm --filter @loro/core-rs check:browser && pnpm --filter @loro/core-rs check:uniffi && turbo run lint typecheck test content:validate check:a11y check:contrast",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter @loro/mobile test:e2e",
    "test:e2e:pseudo-locale": "pnpm --filter @loro/mobile test:e2e:pseudo-locale",
    "storybook": "pnpm --filter @loro/mobile storybook",
    "build-storybook": "pnpm --filter @loro/mobile build-storybook",
    "test:e2e:workbench": "pnpm --filter @loro/mobile test:e2e:workbench",
    "test:e2e:workbench:update": "pnpm --filter @loro/mobile test:e2e:workbench:update",
    "test:e2e:bundle": "pnpm --filter @loro/mobile test:e2e:bundle",
    "test:e2e:install": "pnpm --filter @loro/mobile test:e2e:install",
    "screenshots": "pnpm --filter @loro/mobile screenshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "pnpm --filter @loro/design-tokens build",
    "core-rs:build": "pnpm --filter @loro/core-rs build",
    "core-rs:test": "pnpm --filter @loro/core-rs test",
    "content:validate": "pnpm --filter @loro/content validate",
    "content:gap-priority": "pnpm --filter @loro/content gap-priority",
    "content:enrich": "pnpm --filter @loro/content enrich",
    "content:render": "pnpm --filter @loro/content render",
    "content:publish": "pnpm --filter @loro/content publish",
    "mobile": "pnpm --filter @loro/mobile",
    "api": "pnpm --filter @loro/api",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "contracts:generate": "pnpm --filter @loro/core contracts:generate",
    "contracts:check": "pnpm --filter @loro/core contracts:check",
    "env:encrypt": "./scripts/secrets.sh encrypt",
    "env:decrypt": "./scripts/secrets.sh decrypt",
    "env:edit": "./scripts/secrets.sh edit",
    "local:up": "pnpm env:decrypt && docker compose up --build -d --wait",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs -f",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:local:native": "bash scripts/ci-local.sh native",
    "ci:local:audit": "bash scripts/ci-local.sh audit",
    "native:evidence": "node scripts/native-device-evidence.mjs",
    "apk:local": "node scripts/apk-local.mjs",
    "ios:local": "node scripts/ios-local.mjs",
    "apk:github": "node scripts/apk-local.mjs --upload",
    "check:routes": "node --test scripts/check-routes.test.mjs && node scripts/check-routes.mjs",
    "check:reuse": "node --test scripts/check-reuse.test.mjs && node scripts/check-reuse.mjs",
    "check:plan-index": "node --test scripts/check-plan-index.test.mjs && node scripts/check-plan-index.mjs",
    "test:deploy": "node --test scripts/ec2-release.test.mjs scripts/ec2-gateway.test.mjs scripts/ec2-backup.test.mjs scripts/ec2-backup-verify.test.mjs",
    "test:native:evidence": "node --test scripts/native-device-evidence.test.mjs scripts/native-wave-scenarios.test.mjs scripts/ios-wave-scenarios.test.mjs scripts/ios-local.test.mjs scripts/ios-evidence-runtime.test.mjs",
    "test:dsp:spike": "node --test scripts/dsp-spike-evidence.test.mjs",
    "test:core-rs-build": "node --test scripts/core-rs-build.test.mjs",
    "test:android-config": "node --test apps/mobile/plugins/app-config.test.cjs apps/mobile/plugins/with-dev-client-identity.test.cjs scripts/android-development.test.mjs scripts/apk-environment.test.mjs",
    "test:ci-local": "node --test scripts/ci-local.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.18.13",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "packages/core-rs/**/*.rs": [
      "rustfmt --edition 2021"
    ],
    "packages/design-tokens/tokens/**/*.json": [
      "pnpm tokens:build && git add packages/design-tokens/out"
    ]
  }
}
