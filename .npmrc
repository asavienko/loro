# node-linker=hoisted, deliberately.
#
# ADR-0014 preferred pnpm's isolated layout because it catches phantom dependencies —
# a package importing something it never declared. That benefit is real, but METRO
# CANNOT RESOLVE THROUGH IT: React Native's resolver walks node_modules directories
# rather than following pnpm's symlink graph, so transitive deps of Expo packages
# (whatwg-fetch, and friends) come back unresolvable at bundle time.
#
# Verified: with `isolated`, `expo export` fails on @expo/metro-runtime's transitive
# imports. With `hoisted`, the bundle builds.
#
# The trade: we lose automatic phantom-dependency detection. Mitigated by `pnpm
# typecheck` (an undeclared import has no types) and by dependency review on PRs.
node-linker=hoisted

strict-peer-dependencies=false
auto-install-peers=true
prefer-workspace-packages=true
save-exact=false
engine-strict=true
