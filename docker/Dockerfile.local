# Build the API's real merge engine without a host Rust installation.
FROM rust:1.94-bookworm AS wasm
RUN cargo install wasm-pack --version 0.13.1 --locked
WORKDIR /core
COPY packages/core-rs/ ./
RUN wasm-pack build --dev --target nodejs --out-dir pkg --locked

FROM node:22-bookworm-slim AS local
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
COPY . .
RUN HUSKY=0 pnpm install --frozen-lockfile
COPY --from=wasm /core/pkg ./packages/core-rs/pkg
ENV CI=1
EXPOSE 3000 8081
CMD ["pnpm", "--filter", "@loro/api", "start"]
