      "gluten": { "en-GB": "gluten", "bg-BG": "глутен", "ru-RU": "глютен" },
      "por favor": { "en-GB": "please", "bg-BG": "моля", "ru-RU": "пожалуйста" }
    },
    "notes": {
      "grammar": {
        "title": "«Sin» without an article",
        "text": "«Sin» takes no article: sin azúcar, sin lactosa, sin gluten."
