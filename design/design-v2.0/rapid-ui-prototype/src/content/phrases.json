[
  {
    "id": "cafe-01",
    "target": "Me pone un cortado, por favor",
    "translations": {
      "en-GB": "A cortado, please",
      "bg-BG": "Едно кортадо, моля",
      "ru-RU": "Мне кортадо, пожалуйста"
    },
    "register": "neutral",
    "region": "ES",
    "tags": ["request", "food", "politeness"],
    "words": {
      "me": { "en-GB": "(for) me", "bg-BG": "на мен", "ru-RU": "мне" },
      "pone": { "en-GB": "(you) put, serve", "bg-BG": "слагате, давате", "ru-RU": "(вы) ставите, подаёте" },
      "un": { "en-GB": "a", "bg-BG": "едно", "ru-RU": "один" },
      "cortado": { "en-GB": "espresso with a dash of milk", "bg-BG": "еспресо с малко мляко", "ru-RU": "эспрессо с каплей молока" },
      "por favor": { "en-GB": "please", "bg-BG": "моля", "ru-RU": "пожалуйста" }
    },
    "notes": {
      "grammar": {
        "title": "«Me pone…»",
        "text": "«Me pone…» (literally “will you put me…”) is the everyday way to order in Spain. It is the usted form of poner, but it doesn't sound stiff."
      },
      "pronunciation": {
        "title": "Soft d, ng before c",
        "ipa": "[me ˈpo.ne uŋ koɾˈta.ðo poɾ faˈβoɾ]",
        "respelling": "meh POH-neh oong kor-TAH-doh, por fah-VOR",
        "text": "The d in cortado is soft, close to the th in “this”. The n of un sounds like ng before the c."
      }
    }
  },
  {
    "id": "cafe-02",
    "target": "¿Tienen leche de avena?",
    "translations": {
      "en-GB": "Do you have oat milk?",
      "bg-BG": "Имате ли овесено мляко?",
      "ru-RU": "У вас есть овсяное молоко?"
    },
    "register": "neutral",
    "region": "ES",
    "tags": ["question", "food"],
    "words": {
      "tienen": { "en-GB": "(you all) have", "bg-BG": "имате", "ru-RU": "у вас есть" },
      "leche": { "en-GB": "milk", "bg-BG": "мляко", "ru-RU": "молоко" },
      "de": { "en-GB": "of", "bg-BG": "от", "ru-RU": "из" },
      "avena": { "en-GB": "oats", "bg-BG": "овес", "ru-RU": "овёс" }
    },
    "notes": {
      "grammar": {
        "title": "Asking the whole café",
        "text": "«Tienen» speaks to the whole place (ustedes). It's the natural way to ask what a café has."
      },
      "pronunciation": {
        "title": "A soft v",
        "ipa": "[ˈtje.nen ˈle.tʃe ðe aˈβe.na]",
        "respelling": "TYEH-nen LEH-cheh deh ah-VEH-nah",
        "text": "The v in avena is a soft b: the lips come close but don't touch."
      }
    }
  },
  {
    "id": "cafe-03",
    "target": "La cuenta, por favor",
    "translations": {
      "en-GB": "The bill, please",
      "bg-BG": "Сметката, моля",
      "ru-RU": "Счёт, пожалуйста"
    },
    "register": "neutral",
    "region": "ES",
    "tags": ["request", "politeness"],
    "words": {
      "la": { "en-GB": "the", "bg-BG": "-та (членуване)", "ru-RU": "(артикль)" },
      "cuenta": { "en-GB": "bill", "bg-BG": "сметка", "ru-RU": "счёт" },
      "por favor": { "en-GB": "please", "bg-BG": "моля", "ru-RU": "пожалуйста" }
    },
    "notes": {
      "grammar": {
        "title": "Always «la cuenta»",
        "text": "Say «la cuenta», with “the”: it's the bill for this table, so never «una cuenta»."
      },
      "pronunciation": {
        "title": "The “kw” in cuenta",
        "ipa": "[la ˈkwen.ta poɾ faˈβoɾ]",
        "respelling": "lah KWEN-tah, por fah-VOR",
        "text": "Cue sounds like “kweh”, and the stress falls on it."
      }
    }
  },
  {
    "id": "cafe-04",
    "target": "¿Nos podemos sentar en la terraza?",
    "translations": {
      "en-GB": "Can we sit on the terrace?",
      "bg-BG": "Може ли да седнем на терасата?",
      "ru-RU": "Можно нам сесть на террасе?"
    },
    "register": "neutral",
    "region": "ES",
    "tags": ["question", "politeness"],
    "words": {
      "nos": { "en-GB": "ourselves", "bg-BG": "(ние) се", "ru-RU": "(мы) себя" },
      "podemos": { "en-GB": "we can", "bg-BG": "можем", "ru-RU": "мы можем" },
      "sentar": { "en-GB": "sit", "bg-BG": "седна", "ru-RU": "сесть" },
      "en": { "en-GB": "on, in", "bg-BG": "на, в", "ru-RU": "на, в" },
      "la": { "en-GB": "the", "bg-BG": "-та (членуване)", "ru-RU": "(артикль)" },
      "terraza": { "en-GB": "terrace", "bg-BG": "тераса", "ru-RU": "терраса" }
    },
    "notes": {
      "grammar": {
        "title": "Where «nos» goes",
        "text": "«Nos» can go before the verb or on the end: «¿Podemos sentarnos…?» means the same."
      },
      "pronunciation": {
        "title": "Castilian z and rr",
        "ipa": "[nos poˈðe.mos senˈtaɾ en la teˈra.θa]",
        "respelling": "nos poh-DEH-mos sen-TAR en lah teh-RRAH-thah",
        "text": "In Spain the z in terraza sounds like the th in “think”. The rr is rolled."
      }
    }
  },
