{
  "extends": ["../../tsconfig.base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "composite": false,
    "paths": {
      "@/*": ["./src/*"],
      "@loro/core": ["../../packages/core/src/index.ts"],
      "@loro/core/*": ["../../packages/core/src/*"],
      "@loro/design-tokens": ["../../packages/design-tokens/out/tokens.ts"],
      "@loro/content": ["../../packages/content/src/index.ts"]
    }
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "modules/**/*.ts",
    "scripts/**/*",
    "e2e/**/*",
    ".expo/types/**/*",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
