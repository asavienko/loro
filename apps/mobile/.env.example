# Copy to .env. Only EXPO_PUBLIC_* values reach the bundle.
#
# THERE IS NO PROVIDER API KEY IN THIS APP. Every third-party call is proxied through
# our API, which is what makes rate limiting, budget enforcement, and key rotation
# possible at all. See docs/architecture/security-privacy.md#encryption

# ── API ──
# On a PHYSICAL DEVICE, use your LAN IP — a device cannot reach localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_CDN_URL=http://localhost:9000/loro-content

EXPO_PUBLIC_ENV=development

# ── Observability ──
# Public by design — a DSN is not a secret.
EXPO_PUBLIC_SENTRY_DSN=

# ── Local development toggles ──
# Force reveal mode to exercise the no-microphone path.
EXPO_PUBLIC_FORCE_REVEAL_MODE=false
# Log every engine decision. Noisy.
EXPO_PUBLIC_DEBUG_ENGINES=false
# Show the frame-rate overlay. Useful for the warming-card check.
EXPO_PUBLIC_SHOW_FPS=false
