{
  "name": "@loro/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "node ../../scripts/android-development.mjs",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src scripts",
    "test": "tsx --import ./src/shared/content/fixture.install.ts --test \"src/**/*.test.ts\"",
    "bundle": "expo export --platform ios --output-dir .expo-export --clear",
    "export:web": "expo export --platform web --output-dir dist-web",
    "icons": "node scripts/icons.mjs",
    "clean": "rm -rf .expo .expo-export dist-web node_modules/.cache"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@formatjs/intl-displaynames": "^7.3.15",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-numberformat": "^9.4.3",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@formatjs/intl-relativetimeformat": "^12.3.15",
    "@posthog/react-native-plugin": "^2.12.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "54.0.36",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
