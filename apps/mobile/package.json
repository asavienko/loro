{
  "name": "@loro/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.mjs",
    "test:e2e:pseudo-locale": "playwright test --config e2e/playwright.config.pseudo-locale.mjs",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.mjs --ui",
    "test:e2e:workbench": "playwright test --config e2e/playwright.config.workbench.mjs",
    "test:e2e:workbench:update": "playwright test --config e2e/playwright.config.workbench.mjs --update-snapshots",
    "test:e2e:bundle": "playwright test --config e2e/playwright.config.production.mjs",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint app src scripts e2e",
    "check:lang": "tsx scripts/a11yChecks.ts lang",
    "check:chart-summaries": "tsx scripts/a11yChecks.ts chart-summaries",
    "check:tap-targets": "tsx scripts/a11yChecks.ts tap-targets",
    "check:copy": "tsx scripts/copyOwnership.ts",
    "clean": "rm -rf .expo dist node_modules/.cache",
    "check:a11y": "tsx scripts/a11yChecks.ts all && pnpm check:copy",
    "bundle": "expo export --platform ios --output-dir .expo-export --clear"
  },
  "$comment": [
    "Expo SDK 54 pairs with React Native 0.81.6 and React 19.1.9.",
    "",
    "Only the SDK core is pinned here. The rest of the Expo modules (router, av,",
    "notifications, secure-store, skia, reanimated, op-sqlite, ...) are added with",
    "`npx expo install <pkg>`, which resolves the version that MATCHES THE SDK rather",
    "than the latest published one. Hand-pinning 40 SDK-coupled versions is how an",
    "Expo project ends up unbuildable. See apps/mobile/README.md#adding-a-dependency"
  ],
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@formatjs/intl-pluralrules": "^6.3.13",
    "@loro/content": "workspace:*",
    "@loro/core": "workspace:*",
    "@loro/core-rs": "workspace:^",
    "@loro/design-tokens": "workspace:*",
    "@op-engineering/op-sqlite": "^18.2.1",
    "expo": "54.0.36",
    "expo-constants": "^18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "^14.0.12",
    "expo-linking": "^8.0.12",
    "expo-localization": "~17.0.9",
    "expo-modules-core": "~3.0.30",
    "expo-network": "~8.0.8",
    "expo-router": "^6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "^31.0.13",
    "expo-status-bar": "^3.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.13",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^4.1.7",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@formatjs/icu-messageformat-parser": "^3.5.17",
    "@playwright/test": "^1.62.0",
    "@types/react": "~19.1.0",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
