{
  "name": "@loro/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint app src scripts",
    "check:lang": "tsx scripts/a11yChecks.ts lang",
    "check:chart-summaries": "tsx scripts/a11yChecks.ts chart-summaries",
    "check:tap-targets": "tsx scripts/a11yChecks.ts tap-targets",
    "clean": "rm -rf .expo dist node_modules/.cache",
    "check:a11y": "tsx scripts/a11yChecks.ts all",
    "bundle": "expo export --platform ios --output-dir .expo-export --clear"
  },
  "$comment": [
    "Expo SDK 54 pairs with React Native 0.81.6 and React 19.1.9.",
    "",
    "Only the SDK core is pinned here. The rest of the Expo modules (router, av,",
    "notifications, secure-store, skia, reanimated, op-sqlite, ...) are added with",
    "`npx expo install <pkg>`, which resolves the version that MATCHES THE SDK rather",
    "than the latest published one. Hand-pinning 40 SDK-coupled versions is how an",
    "Expo project ends up unbuildable. See apps/mobile/README.md#adding-a-dependency"
  ],
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@loro/content": "workspace:*",
    "@loro/core": "workspace:*",
    "@loro/design-tokens": "workspace:*",
    "expo": "54.0.36",
    "expo-constants": "^18.0.13",
    "expo-font": "^14.0.12",
    "expo-linking": "^8.0.12",
    "expo-router": "^6.0.24",
    "expo-splash-screen": "^31.0.13",
    "expo-status-bar": "^3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^4.1.7",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
