{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Plain browser modules with JSDoc types: tsc only checks them, and the browser runs the
    // files as written, so there is no build step to deploy.
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "scripts/**/*"]
}
