# Copy to .env. Values below are the LOCAL defaults and work with docker-compose.
#
# Local development is deliberately offline-capable and free: AI and TTS are stubbed,
# so no credentials are needed on day one. See docs/process/environments.md

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Data ──
DATABASE_URL=postgres://loro:loro@localhost:5432/loro
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=loro-content
S3_ACCESS_KEY=loro
S3_SECRET_KEY=loro-dev-secret
CDN_BASE_URL=http://localhost:9000/loro-content

# ── Auth ──
# Explicit false disables all sign-in. Browser Google/Apple flows require true and the variables below.
# Omit AUTH_ENABLED to use only configured direct-ID/email sign-in.
AUTH_ENABLED=false
# Local Google/Apple: AUTH_ENABLED=true, AUTH_PUBLIC_URL=http://localhost:3000,
# AUTH_REDIRECT_URIS=http://localhost:8081/account,http://127.0.0.1:8081/account,loro://account,loro-dev://account
# (loro:// and loro-dev:// are the app's and the development build's return from Google on a phone)
# and register http://localhost:3000/v1/auth/google/callback on the Google client.
AUTH_PUBLIC_URL=
AUTH_REDIRECT_URIS=
# ES256 is preferred; legacy deployments may instead retain a random HS256 key >=32 bytes.
AUTH_SIGNING_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Generate an ES256 pair for local use:
#   openssl ecparam -genkey -name prime256v1 -noout -out /tmp/k.pem
#   openssl pkcs8 -topk8 -nocrypt -in /tmp/k.pem
# Store the multiline PKCS8 PEM in the encrypted environment, never commit a key.
AUTH_PRIVATE_KEY_PEM=
AUTH_ISSUER=https://api.loro.app
AUTH_KEY_ID=primary
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Stable random secret >=32 chars; changing without identity migration changes email accounts.
AUTH_EMAIL_HASH_KEY=
# HTTPS sender webhook: accepts {email,code,expires_in:600}; no development/logging fallback.
# Local development may use loopback HTTP, e.g. http://127.0.0.1:8787/send with
# `node scripts/local-magic-delivery.mjs`. The development EC2 host may use
# inbox:local, which writes /tmp/loro-magic-delivery.json inside the API container.
# A public mail sender still requires HTTPS.
AUTH_MAGIC_DELIVERY_URL=
AUTH_MAGIC_DELIVERY_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# ── AI ──
# 'stub' returns the bundled fallback scenes — no key, no cost, works offline.
# Switching to 'anthropic' is an explicit choice, never an accident.
AI_PROVIDER=stub
ANTHROPIC_API_KEY=
AI_MODEL_SCENE=claude-sonnet-5
AI_MODEL_COACH=claude-haiku-4-5-20251001
AI_MODEL_TRANSLATE=claude-haiku-4-5-20251001
AI_MODEL_ENRICH=claude-opus-5

# Budgets fail SILENTLY to the bundled fallback. A "you've used your allowance"
# message would turn a graceful degradation into a visible failure.
AI_MONTHLY_BUDGET_USD_PER_USER=0.50
AI_DAILY_BUDGET_USD_GLOBAL=200
AI_SCENE_CACHE_TTL_DAYS=30

# ── TTS ──
# Selected production provider: ElevenLabs (2026-09-07). Local default is stub so
# CI and local:up never spend credits. Documented Q-15 catalog pins (AS-01) are
# below; runtime still reads these env vars. Listening IDs live only in
# LISTENING_VOICE_DECISION — do not treat TTS_LISTENING_VOICE_IDS as a second
# switch. Live generate needs TTS_PROVIDER=elevenlabs, TTS_API_KEY, a paid plan,
# and Voice Library add-to-My-Voices. Catalog reference render/asset and
# GET /tts/status may omit a bearer so web and APK can play phrases.
# Catalog reference and listening-class may omit a bearer when TTS_PROVIDER=elevenlabs.
# Cloud ASR and voice-clone routes are forbidden. TTS_STUB_RENDER=1 is local/dev labeled listening-class
# silence (checksum metadata + native download). CI stays 0. Stub audio must
# not be presented as licensed neural quality and cannot publish catalog audio.
# Leave AUTH_PUBLIC_URL empty locally so download_url echoes the request Host.
TTS_PROVIDER=stub
TTS_API_KEY=
TTS_MODEL=eleven_multilingual_v2
TTS_OUTPUT_FORMAT=mp3_44100_128
TTS_VOICE_ES_ES=t9LRTh3y1ioN00e9wsNh
TTS_VOICE_BG_BG=406EiNlYvqFqcz3vsnOm
TTS_VOICE_RU_RU=1qd9R09Ljlx9V1Ok0t5S
TTS_CACHE_DIR=
TTS_LISTENING_VOICE_IDS=
TTS_STUB_RENDER=0
# One voice per variant, FOREVER. Changing it would change every learner's
# pronunciation reference mid-learning and invalidate every f0_native contour.

# ── Music (plan 96) ──
# Separate from TTS_PROVIDER and AI_PROVIDER. Default stub / fixtures never spend.
MUSIC_PROVIDER=stub
MUSIC_API_KEY=
MUSIC_BASE_URL=https://api.elevenlabs.io
MUSIC_MONTHLY_BUDGET_USD_PER_USER=0
MUSIC_DAILY_BUDGET_USD_GLOBAL=0

# ── Library (plan 106) ──
# Claude writes phrase decks, lyrics and covers when ANTHROPIC_API_KEY is set (see AI above); without
# it the bank, the set's own phrases and drawn patterns answer, each labelled. Songs are sung by
# ElevenLabs Music only with MUSIC_PROVIDER=elevenlabs and MUSIC_API_KEY; otherwise they get the
# demo instrumental, labelled "Demo sound".
AI_MODEL_GENERATE=claude-sonnet-5
# Per learner per UTC day. 0 turns that kind of generation off.
LIMIT_PHRASES_DAILY=30
LIMIT_COVER_DAILY=10
LIMIT_SONG_DAILY=5
# New phrase clips the server's voices render per day, across all learners (library/speech.ts).
LIMIT_SPEECH_RENDERS_DAILY=500
# ...and per learner, for the clips of their own phrases.
LIMIT_SPEECH_OWNER_DAILY=100
# Loro's album songs get the server's voice once, in the background; 0 leaves them instrumental.
LIBRARY_VOICE_LORO_SONGS=1
# What one account keeps.
LIMIT_SETS_KEPT=100
LIMIT_ALBUMS_KEPT=30
LIMIT_SONGS_KEPT=120
# Signs song audio URLs; set it when more than one API process shares the database.
LIBRARY_URL_SECRET=

# ── Billing ──
APPLE_TEAM_ID=
APPLE_SHARED_SECRET=
GOOGLE_PLAY_SA_JSON=
# Entitlements are cached client-side with a grace period, so a learner abroad with
# no network doesn't lose Plus mid-trip.
ENTITLEMENT_GRACE_DAYS=7

# ── Observability ──
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ── Content ──
CONTENT_LANG=es-ES
