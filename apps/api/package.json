{
  "name": "@loro/api",
  "version": "0.0.0",
  "private": true,
  "description": "Loro backend — sync arbitration, content distribution, AI and TTS proxying.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "start": "tsx src/main.ts",
    "author:run": "tsx src/authoring/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1145.0",
    "@loro/content": "workspace:*",
    "@loro/core": "workspace:*",
    "@loro/core-rs": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
