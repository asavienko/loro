{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", ".nvmrc"],
  "globalEnv": ["NODE_ENV", "CI"],
  // Strict env mode hides rustup when CARGO_HOME/RUSTUP_HOME are not ~/.cargo.
  // Pass the homes, not RUSTUP_TOOLCHAIN: a stale override (1.83 here) would
  // hide the crate's rust-version 1.88 default.
  "globalPassThroughEnv": ["CARGO_HOME", "RUSTUP_HOME"],
  "tasks": {
    "core-rs:build": {
      "inputs": ["packages/core-rs/src/**", "packages/core-rs/Cargo.toml", "packages/core-rs/*.udl"],
      "outputs": ["packages/core-rs/target/**", "packages/core-rs/bindings/**", "packages/core-rs/pkg/**"],
      "cache": true
    },
    "core-rs:test": {
      "inputs": ["packages/core-rs/**"],
      "cache": true
    },
    "content:validate": {
      "inputs": ["packages/content/**/*.json", "packages/content/src/**"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "core-rs:build"],
      "outputs": ["dist/**", ".expo/**", "build/**", "out/**"]
    },
    // `@loro/api` depends on `@loro/core-rs`, so `^build` reaches its build script —
    // which is cargo + wasm-pack, not tsc. Without this override it inherits the
    // generic `build` outputs, finds none of them, and warns while caching nothing.
    "@loro/core-rs#build": {
      "inputs": ["src/**", "Cargo.toml", "Cargo.lock", "build.sh", "*.udl"],
      "outputs": ["pkg/**", "bindings/**", "target/release/libloro_core.*"]
    },
    // The proof the app actually compiles. Not part of `check` — it takes minutes — but
    // `pnpm ci:local` runs it.
    "bundle": {
      "outputs": [".expo-export/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "core-rs:build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
