# ── dependencies ──
node_modules/
.pnpm-store/

# ── build output ──
dist/
build/
out/
# Generated, but COMMITTED — see ADR-0014. The comment is on its own line because
# .gitignore has no trailing comments: with `# …` after the pattern, the whole line
# was the pattern, it matched nothing, and design-tokens/out/ stayed ignored. The
# `drift` job in CI diffs that directory, so it could never fail.
!packages/design-tokens/out/
.turbo/
*.tsbuildinfo

# ── rust ──
target/
packages/core-rs/pkg/
Cargo.lock                       # workspace-level; the crate's own lockfile IS committed
!packages/core-rs/Cargo.lock

# ── expo / react native ──
.expo/
.expo-shared/
# `expo export` output — the bundle CI builds to prove the app compiles.
.expo-export/
.expo-export-web/
# Native projects are regenerated from app.config.ts and local Expo modules (CNG).
apps/mobile/android/
apps/mobile/ios/
*.jsbundle
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/*.xcworkspace/xcuserdata/
apps/mobile/ios/*.xcodeproj/xcuserdata/
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/local.properties
apps/mobile/android/.cxx/
*.keystore
!debug.keystore

# ── secrets and local config ──
.env
.env.*
*.env
!.env.example
!secrets/*.enc.env
*.pem
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
service-account*.json

# ── learner data · NEVER commit ──
# See docs/architecture/security-privacy.md
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
diagnostics-*.json
**/recordings/*.wav
**/recordings/*.m4a
!packages/core-rs/tests/golden/recordings/    # consented test fixtures only

# ── test and coverage ──
coverage/
.nyc_output/
test-results/
playwright-report/
.ci-local-reports/
.ci-local.lock
maestro-debug-output/
*.hprof

# ── editors ──
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# ── os ──
.DS_Store
Thumbs.db

# Catalog TTS render cache (plan 98). Never commit stub or failed audio.
packages/content/.render-cache/

# ── logs ──
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
.gstack/

# Local agent checkouts are independent Git worktrees, not project source.
.claude/worktrees/

# age identities and interrupted SOPS staging files stay local.
*.agekey
secrets/.encrypt.*

# Local APK artifacts; generated native projects are built in temporary snapshots.
.local-builds/
