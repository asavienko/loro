# ── dependencies ──
node_modules/
.pnpm-store/

# ── build output ──
dist/
build/
out/
!packages/design-tokens/out/     # generated, but COMMITTED — see ADR-0014
.turbo/
*.tsbuildinfo

# ── rust ──
target/
packages/core-rs/pkg/
Cargo.lock                       # workspace-level; the crate's own lockfile IS committed
!packages/core-rs/Cargo.lock

# ── expo / react native ──
.expo/
.expo-shared/
# `expo export` output — the bundle CI builds to prove the app compiles.
.expo-export/
*.jsbundle
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/*.xcworkspace/xcuserdata/
apps/mobile/ios/*.xcodeproj/xcuserdata/
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/local.properties
apps/mobile/android/.cxx/
*.keystore
!debug.keystore

# ── secrets and local config ──
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
service-account*.json

# ── learner data · NEVER commit ──
# See docs/architecture/security-privacy.md
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
diagnostics-*.json
**/recordings/*.wav
**/recordings/*.m4a
!packages/core-rs/tests/golden/recordings/    # consented test fixtures only

# ── test and coverage ──
coverage/
.nyc_output/
test-results/
maestro-debug-output/
*.hprof

# ── editors ──
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# ── os ──
.DS_Store
Thumbs.db

# ── logs ──
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
