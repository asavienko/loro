{
  "name": "@loro/content",
  "version": "0.0.0",
  "private": true,
  "description": "The Spanish catalog \u2014 phrases, scenarios, packs, drop schedules.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "validate": "tsx src/validate.ts",
    "validate:schema": "tsx src/validate.ts --only schema",
    "validate:packs": "tsx src/validate.ts --only packs",
    "validate:refs": "tsx src/validate.ts --only refs",
    "validate:audio": "tsx src/validate.ts --only audio",
    "validate:prosody": "tsx src/validate.ts --only prosody",
    "validate:duplicates": "tsx src/validate.ts --only duplicates",
    "validate:stress": "tsx src/validate.ts --only stress",
    "validate:length": "tsx src/validate.ts --only length",
    "validate:graph": "tsx src/validate.ts --only graph",
    "enrich": "tsx src/enrich.ts",
    "render": "tsx src/renderCli.ts",
    "publish": "tsx src/publish.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "review:export": "tsx src/exportReviewPacket.ts",
    "draft:phrases": "tsx src/draftPhrases.ts",
    "gap-priority": "tsx src/gapPriorityCli.ts",
    "check:release": "tsx src/releaseCheck.ts"
  },
  "dependencies": {
    "@loro/core": "workspace:*",
    "ajv": "^8.20.0",
    "zod": "^4"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": "./src/index.ts",
    "./fs": "./src/fs.ts",
    "./types": "./src/types.ts",
    "./audio-duration": "./src/audioDuration.ts"
  }
}
