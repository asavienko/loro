{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loro.app/schema/graph.json",
  "title": "Loro catalog phrase graph",
  "description": "Authored edges between catalog phrases.",
  "type": "object",
  "required": ["lang", "edges"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "array", "items": { "type": "string" } },
    "lang": { "type": "string", "minLength": 2 },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation", "weight"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": {
            "enum": ["scenario_next", "reply", "lexical", "contrast", "prerequisite", "register_shift"]
          },
          "weight": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    }
  }
}
