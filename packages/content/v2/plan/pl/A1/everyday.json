          {
            "lemma": "dziękuję",
            "gloss": "thank you",
            "pos": "interj"
          }
        ],
        "avoid": {
          "lemmas": ["szpital", "operacja", "rak"],
          "themes": ["serious illness", "drug names and doses in numbers", "alcohol"],
          "textKeys": "siblings"
        },
        "mention": ["«Coś na ból głowy / na kaszel» is how you ask for something against a complaint."],
        "doNotMention": [
          "brand names of medicines",
          "doses in numbers",
          "serious illness",
          "ty forms to the pharmacist"
        ],
        "variety": null,
        "notesHints": ["«boli mnie głowa»: literally «the head hurts me»"]
      }
