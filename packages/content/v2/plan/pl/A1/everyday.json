    {
      "setId": "set-pl-a1-food-shop",
      "course": "pl-PL",
      "level": "A1",
      "topic": "everyday",
      "situation": "food-shop",
      "count": 12,
      "song": false,
      "brief": {
        "edited": true,
        "scene": "At a small Polish grocery shop (sklep spożywczy) with a counter: asking for bread, rolls, cheese and butter, how much of each, whether something is fresh, a bag, anything else.",
        "speakers": ["customer", "shop assistant"],
        "register": "neutral; customer and assistant use pan/pani with the third person",
        "grammarFocus": [
          {
            "id": "pl-accusative-object",
            "kind": "case",
            "rule": "The direct object of poproszę, chcę, kupię, mam takes the accusative: feminine -a becomes -ę (bułka → bułkę, tabletka → tabletkę); masculine inanimate and neuter nouns do not change (bilet, chleb, mleko).",
            "example": "Poproszę bilet i mapę miasta.",
            "minPhrases": 3
          },
          {
            "id": "pl-genitive-quantity",
            "kind": "case",
            "rule": "After a quantity word (ile, pół, kilo, kawałek, dużo, trochę) and after «nie ma» the noun takes the genitive: kilo jabłek, kawałek sera, trochę masła, nie ma chleba.",
            "example": "Poproszę kawałek sera i trochę masła.",
            "minPhrases": 3
          },
          {
            "id": "pl-pan-pani-formal",
            "kind": "register",
            "rule": "Formal address to a stranger: pan (to a man) / pani (to a woman) with the verb in the third person singular: «Czy pani wie, gdzie…?», «Czy pan ma…?»; never ty to strangers or staff.",
            "example": "Przepraszam, czy pan wie, gdzie jest dworzec?",
            "minPhrases": 3
          }
        ],
        "functions": ["request", "ask-availability", "ask-price", "decline", "thank"],
        "mustUse": [
          {
            "lemma": "chleb",
            "gloss": "bread",
            "pos": "noun"
          },
          {
            "lemma": "bułka",
            "gloss": "bread roll",
            "pos": "noun"
          },
          {
            "lemma": "ser",
            "gloss": "cheese",
            "pos": "noun"
          },
          {
            "lemma": "masło",
            "gloss": "butter",
            "pos": "noun"
          },
          {
            "lemma": "jajko",
            "gloss": "egg",
            "pos": "noun"
          },
          {
            "lemma": "mleko",
            "gloss": "milk",
            "pos": "noun"
          },
          {
            "lemma": "świeży",
            "gloss": "fresh",
            "pos": "adj"
          },
          {
            "lemma": "kawałek",
            "gloss": "a piece",
            "pos": "noun"
          },
          {
            "lemma": "torba",
            "gloss": "bag",
            "pos": "noun"
          },
          {
            "lemma": "trochę",
            "gloss": "a little, some",
            "pos": "adv"
          },
          {
            "lemma": "jeszcze",
            "gloss": "still; more, else",
            "pos": "adv"
          },
          {
            "lemma": "nie ma",
            "gloss": "there is no",
            "pos": "phrase"
          }
        ],
        "shouldUse": [
          {
            "lemma": "poproszę",
            "gloss": "I'd like (polite request)",
            "pos": "verb"
          },
          {
            "lemma": "to wszystko",
            "gloss": "that's all",
            "pos": "phrase"
          }
        ],
        "avoid": {
          "lemmas": ["jabłko", "pomidor", "kilo"],
          "themes": ["alcohol", "prices in numbers", "politics"],
          "textKeys": "siblings"
        },
        "mention": [
          "At a counter shop you say what you want and the assistant hands it over; «Coś jeszcze?» means anything else."
        ],
        "doNotMention": ["brand names", "prices in numbers", "ty forms to the assistant"],
        "variety": null,
        "notesHints": ["«bułka»: the everyday roll, bought by the piece"]
      }
    },
    {
      "setId": "set-pl-a1-pharmacy",
      "course": "pl-PL",
      "level": "A1",
      "topic": "everyday",
      "situation": "pharmacy",
      "count": 12,
      "song": false,
      "brief": {
        "edited": true,
        "scene": "At a Polish pharmacy with a mild cold or a headache: saying what hurts, asking for something for it, how to take it, whether a prescription is needed.",
        "speakers": ["customer", "pharmacist"],
        "register": "neutral; customer and pharmacist use pan/pani with the third person",
        "grammarFocus": [
          {
            "id": "pl-boli-pain",
            "kind": "construction",
            "rule": "Saying what hurts: «boli mnie» + the body part in the nominative (boli mnie głowa, boli mnie gardło); «mam» + accusative for a symptom (mam gorączkę, mam katar).",
            "example": "Boli mnie gardło i mam katar.",
            "minPhrases": 3
          },
          {
            "id": "pl-accusative-object",
            "kind": "case",
            "rule": "The direct object of poproszę, chcę, kupię, mam takes the accusative: feminine -a becomes -ę (bułka → bułkę, tabletka → tabletkę); masculine inanimate and neuter nouns do not change (bilet, chleb, mleko).",
            "example": "Poproszę bilet i mapę miasta.",
            "minPhrases": 3
          },
          {
            "id": "pl-czy-question",
            "kind": "construction",
            "rule": "A yes/no question may start with «czy», the word order otherwise unchanged: «Czy ten tramwaj jedzie do centrum?», «Czy jest winda?».",
            "example": "Czy to daleko stąd?",
            "minPhrases": 3
          }
        ],
        "functions": ["request", "explain", "ask-availability", "thank"],
        "mustUse": [
          {
            "lemma": "głowa",
            "gloss": "head",
            "pos": "noun"
          },
          {
            "lemma": "gardło",
            "gloss": "throat",
            "pos": "noun"
          },
          {
