            "pos": "noun"
          },
          {
            "lemma": "kaszel",
            "gloss": "cough",
            "pos": "noun"
          },
          {
            "lemma": "tabletka",
            "gloss": "tablet, pill",
            "pos": "noun"
          },
          {
            "lemma": "syrop",
            "gloss": "syrup",
            "pos": "noun"
          },
          {
            "lemma": "recepta",
            "gloss": "prescription",
            "pos": "noun"
          },
          {
            "lemma": "boleć",
            "gloss": "to hurt",
            "pos": "verb"
          },
          {
            "lemma": "na",
            "gloss": "for (a complaint: na kaszel)",
            "pos": "prep"
