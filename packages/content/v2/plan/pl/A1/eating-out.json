      "brief": {
        "edited": true,
        "scene": "A customer orders at the counter of a Kraków café in the morning; the barista answers. Short exchanges: what to drink, with milk or not, something sweet, here or to take away, paying.",
        "speakers": ["customer", "barista"],
        "register": "neutral; customer and barista address each other as pan/pani with the third person, never ty",
        "grammarFocus": [
          {
            "id": "pl-accusative-object",
            "kind": "case",
            "rule": "The direct object of poproszę, chcę, wezmę, mam takes the accusative: feminine -a becomes -ę (kawa → kawę, herbata → herbatę, woda → wodę); masculine inanimate and neuter nouns do not change (sok, rachunek, ciastko).",
            "example": "Poproszę wodę i jedno ciastko.",
            "minPhrases": 4
          },
          {
            "id": "pl-poprosze-request",
            "kind": "construction",
            "rule": "Ordering politely with «poproszę» + accusative (I'd like…), or «czy mogę prosić o…» + accusative; «dla mnie» picks one's own order.",
            "example": "Dla mnie poproszę herbatę z cytryną.",
            "minPhrases": 3
          },
          {
            "id": "pl-pan-pani-formal",
            "kind": "register",
            "rule": "Formal address to a stranger: pan (to a man) / pani (to a woman) with the verb in the third person singular: «Czy pani przyjmuje karty?», «Co pan poleca?»; never ty to staff.",
            "example": "Czy pan ma coś bez mleka?",
            "minPhrases": 3
