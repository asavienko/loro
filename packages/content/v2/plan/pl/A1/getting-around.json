    {
      "setId": "set-pl-a1-bus-tram",
      "course": "pl-PL",
      "level": "A1",
      "topic": "getting-around",
      "situation": "bus-tram",
      "count": 12,
      "song": false,
      "brief": {
        "edited": true,
        "scene": "Getting about Warsaw or Kraków by tram and bus: buying a ticket at a machine or a kiosk, a reduced or a full fare, checking which line goes where, validating the ticket, asking where to get off and where to change.",
        "speakers": ["passenger", "another passenger"],
        "register": "neutral; strangers use pan/pani with the third person",
        "grammarFocus": [
          {
            "id": "pl-czy-question",
            "kind": "construction",
            "rule": "A yes/no question may start with «czy», the word order otherwise unchanged: «Czy ten tramwaj jedzie do centrum?», «Czy jest winda?».",
            "example": "Czy to daleko stąd?",
            "minPhrases": 3
          },
          {
            "id": "pl-do-genitive",
            "kind": "case",
            "rule": "Going to a place: «do» + genitive: dworzec → do dworca, centrum → do centrum, rynek → do rynku, apteka → do apteki.",
            "example": "Jak dojść do rynku?",
            "minPhrases": 3
          },
          {
            "id": "pl-locative-place",
            "kind": "case",
            "rule": "Where something is: «na» or «w» + locative: na przystanku, na peronie, w centrum, na rogu, w pokoju.",
            "example": "Czekam na przystanku.",
            "minPhrases": 3
          }
        ],
        "functions": ["request", "ask-location", "ask-availability", "thank"],
        "mustUse": [
          {
            "lemma": "bilet",
            "gloss": "ticket",
            "pos": "noun"
          },
          {
            "lemma": "ulgowy",
            "gloss": "reduced (fare)",
            "pos": "adj"
          },
          {
            "lemma": "normalny",
            "gloss": "full (fare)",
            "pos": "adj"
          },
          {
            "lemma": "tramwaj",
            "gloss": "tram",
            "pos": "noun"
          },
          {
            "lemma": "autobus",
            "gloss": "bus",
            "pos": "noun"
          },
          {
            "lemma": "linia",
            "gloss": "line, route number",
            "pos": "noun"
          },
          {
            "lemma": "przystanek",
            "gloss": "stop",
            "pos": "noun"
          },
          {
            "lemma": "następny",
            "gloss": "next",
            "pos": "adj"
          },
          {
            "lemma": "przesiadka",
            "gloss": "change (between lines)",
            "pos": "noun"
          },
          {
            "lemma": "skasować",
            "gloss": "to validate (a ticket)",
            "pos": "verb"
          },
          {
            "lemma": "wysiadać",
            "gloss": "to get off",
            "pos": "verb"
          },
          {
            "lemma": "centrum",
            "gloss": "the city centre",
            "pos": "noun"
          }
        ],
        "shouldUse": [
          {
            "lemma": "przepraszam",
            "gloss": "excuse me",
            "pos": "interj"
          },
          {
            "lemma": "dziękuję",
            "gloss": "thank you",
            "pos": "interj"
          }
        ],
        "avoid": {
          "lemmas": ["taksówka", "samochód", "mandat"],
          "themes": ["alcohol", "prices in numbers", "politics"],
          "textKeys": "siblings"
        },
        "mention": [
          "In Polish cities a paper ticket is validated («skasować») on boarding.",
          "«Ulgowy» is the reduced fare for students and pensioners; «normalny» is the full one."
        ],
        "doNotMention": ["brand names or app names", "exact fares", "fines and inspectors", "ty forms to strangers"],
        "variety": null,
        "notesHints": ["«skasować bilet»: to validate, not to cancel"]
      }
    },
    {
      "setId": "set-pl-a1-asking-the-way",
      "course": "pl-PL",
      "level": "A1",
      "topic": "getting-around",
      "situation": "asking-the-way",
      "count": 12,
      "song": false,
      "brief": {
        "edited": true,
        "scene": "On foot in a Polish old town: asking a passer-by the way to the market square, a pharmacy or the station, understanding left, right and straight on, how far it is.",
        "speakers": ["visitor", "passer-by"],
        "register": "neutral; strangers use pan/pani with the third person; the passer-by answers with «proszę iść…» or the imperative",
        "grammarFocus": [
          {
            "id": "pl-pan-pani-formal",
            "kind": "register",
            "rule": "Formal address to a stranger: pan (to a man) / pani (to a woman) with the verb in the third person singular: «Czy pani wie, gdzie…?», «Czy pan ma…?»; never ty to strangers or staff.",
            "example": "Przepraszam, czy pan wie, gdzie jest dworzec?",
            "minPhrases": 3
          },
          {
            "id": "pl-do-genitive",
            "kind": "case",
            "rule": "Going to a place: «do» + genitive: dworzec → do dworca, centrum → do centrum, rynek → do rynku, apteka → do apteki.",
            "example": "Jak dojść do rynku?",
            "minPhrases": 3
          },
          {
            "id": "pl-prosze-infinitive",
            "kind": "construction",
            "rule": "Giving directions politely: «proszę» + infinitive (proszę iść prosto, proszę skręcić w lewo) or the imperative (niech pan idzie…, skręć for a friend).",
            "example": "Proszę iść prosto i skręcić w prawo.",
            "minPhrases": 3
          }
        ],
        "functions": ["ask-location", "request", "thank", "explain"],
        "mustUse": [
