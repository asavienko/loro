            "gloss": "map",
            "pos": "noun"
          }
        ],
        "shouldUse": [
          {
            "lemma": "przepraszam",
            "gloss": "excuse me",
            "pos": "interj"
          },
          {
            "lemma": "dziękuję bardzo",
            "gloss": "thank you very much",
            "pos": "phrase"
          }
        ],
        "avoid": {
          "lemmas": ["taksówka", "autobus", "tramwaj", "bilet"],
          "themes": ["alcohol", "prices in numbers", "politics"],
          "textKeys": "siblings"
        },
        "mention": ["Most Polish old towns are built around a «rynek», the market square."],
        "doNotMention": ["brand names", "distances in numbers", "ty forms to strangers"],
        "variety": null,
        "notesHints": ["«w lewo» / «w prawo»: left / right, with «w» and no case ending to learn"]
