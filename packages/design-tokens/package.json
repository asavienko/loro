{
  "name": "@loro/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens extracted from the blueprint. Generates TS, Swift, and Kotlin.",
  "type": "module",
  "main": "./out/tokens.ts",
  "types": "./out/tokens.ts",
  "scripts": {
    "build": "tsx src/generate.ts",
    "check:contrast": "tsx src/checkContrast.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf out"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
