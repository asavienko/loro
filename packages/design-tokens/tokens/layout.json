{
  "$comment": "Space, radius, and elevation. From Loro.dc.html. See docs/design/design-system.md",

  "space": {
    "$comment": "An 8px rhythm with 4px half-steps, plus the deviations the blueprint makes for density.",
    "0.5": 2,
    "1": 4,
    "1.5": 6,
    "2": 8,
    "2.5": 10,
    "3": 12,
    "3.5": 14,
    "4": 16,
    "4.5": 18,
    "5": 20,
    "5.5": 22,
    "6": 24
  },

  "gutter": {
    "$comment": "The blueprint varies the screen gutter by density: roomy on reading screens, tight on list-dense ones so rows get more width.",
    "dense": 14,
    "default": 18,
    "roomy": 22
  },

  "radius": {
    "sm": { "value": 8, "use": "micro-pills, day cells, sort segments" },
    "md": { "value": 10, "use": "segmented-control thumb" },
    "lg": { "value": 12, "use": "THE WORKHOUSE — buttons, chips, rows, small cards. When unsure, it's 12" },
    "xl": { "value": 16, "use": "cards, tiles, toasts" },
    "2xl": { "value": 20, "use": "panel cards" },
    "3xl": { "value": 24, "use": "hero cards, dark cards" },
    "pill": { "value": 999, "use": "status pills" },
    "sheet": { "value": "24px 28px 40px 40px", "use": "bottom sheet — asymmetric, wider at the bottom" },
    "screen": { "value": 38, "use": "blueprint device chrome only" },
    "device": { "value": 46, "use": "blueprint device chrome only" }
  },

  "shadow": {
    "$comment": "Four recipes, all low and WARM-TINTED. There are no hard grey drop shadows in this system.",
    "card": { "value": "0 1px 2px rgba(40,34,25,.16)", "use": "segmented thumb, subtle lift" },
    "raised": {
      "value": "0 8px 20px rgba(191,87,34,.32)",
      "use": "primary CTA — accent-tinted, which is what makes it feel warm rather than pasted on"
    },
    "sheet": { "value": "0 -12px 40px rgba(0,0,0,.22)", "use": "bottom sheets" },
    "toast": { "value": "0 10px 24px rgba(0,0,0,.28)", "use": "toasts" },
    "float": { "value": "0 16px 40px rgba(0,0,0,.16)", "use": "the dealt card (Loop C)" }
  },

  "size": {
    "emojiTile": { "sm": 22, "md": 36, "lg": 42, "xl": 46 },
    "micButton": { "sm": 60, "md": 74, "lg": 80 },
    "scoreRing": 58,
    "sheetHandle": { "width": 42, "height": 5 },
    "progressBar": { "thin": 4, "default": 6, "thick": 9, "mastery": 12 },
    "chartHeight": 104,
    "waveformBars": 34,
    "contourPoints": 14
  }
}
