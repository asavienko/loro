{
  "name": "@loro/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared domain model, engine contracts, and API schemas \u2014 used by BOTH the app and the API.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./engines": "./src/engines/index.ts",
    "./sync": "./src/sync/index.ts",
    "./testing": "./src/testing/index.ts",
    "./conformance": "./src/engines/conformance.ts",
    "./api/current": "./src/api/current.ts",
    "./api/catalog": "./src/api/catalog.ts",
    "./api/target": "./src/api/target.ts",
    "./api/draft": "./src/api/draft.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo",
    "contracts:generate": "tsx src/api-tooling/generate.ts",
    "contracts:check": "tsx src/api-tooling/generate.ts --check"
  },
  "devDependencies": {
    "tsx": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4"
  }
}
