{
  "name": "@loro/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared domain model, engine contracts, and API schemas — used by BOTH the app and the API.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./engines": "./src/engines/index.ts",
    "./sync": "./src/sync/index.ts",
    "./testing": "./src/testing/index.ts",
    "./conformance": "./src/engines/conformance.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
