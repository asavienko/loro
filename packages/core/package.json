{
  "name": "@loro/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared domain model, sync merge policy and API schemas \u2014 used by the API and the content tooling.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api/current": "./src/api/current.ts",
    "./api/catalog": "./src/api/catalog.ts",
    "./api/chat-topic": "./src/api/chat-topic.ts",
    "./api/target": "./src/api/target.ts",
    "./api/draft": "./src/api/draft.ts",
    "./api/oauth": "./src/api/oauth.ts",
    "./api/account": "./src/api/account.ts",
    "./api/sync": "./src/api/sync.ts",
    "./api/library": "./src/api/library.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo",
    "contracts:generate": "tsx src/api-tooling/generate.ts",
    "contracts:check": "tsx src/api-tooling/generate.ts --check"
  },
  "devDependencies": {
    "tsx": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4"
  }
}
