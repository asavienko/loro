{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src"
  },
  // `.json` needs its own pattern: an extensionless `include` glob picks up only
  // TS/JS files, so the calendar parity fixture would be invisible to the compiler
  // even with resolveJsonModule on.
  "include": ["src/**/*", "src/**/*.json"]
}
